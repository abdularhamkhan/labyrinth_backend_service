generator client {
  provider        = "prisma-client-js"
  output          = "./generated/prisma"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [uuid_ossp(map: "uuid-ossp"), pg_trgm]
}

// =============================================================================
// ENUMS - Type Safety and Consistency for Labyrinth Platform
// =============================================================================

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  BLOCKED
}

enum MediaCategory {
  USER_AVATAR
  PROJECT_IMAGE
  CHAT_MEDIA
  PROJECT_FILE
  WORKSPACE_BANNER
  SYSTEM_ASSET
}

enum StorageProvider {
  SUPABASE
  CLOUDINARY
  AWS_S3
  LOCAL
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
  BLOCKED
  REJECTED
}

// =============================================================================
// LABYRINTH COLLABORATION PLATFORM MODELS
// =============================================================================

model User {
  id             String    @id @default(uuid())
  email          String    @unique
  username       String    @unique
  passwordHash   String
  firstName      String?
  lastName       String?
  dateOfBirth    DateTime?
  lastActive     DateTime?
  gitHubProfile  String?
  education      String?
  maxDailySwipes Int?
  avatar         String?
  status         String?   @default("ACTIVE")
  totalScore     Int?      @default(0)

  preferences         Preferences?
  techStackId         String?
  techStack           TechStack?        @relation(fields: [techStackId], references: [id])
  demographicId       String?
  demographic         Demographic?      @relation(fields: [demographicId], references: [id])
  match               Match?
  workspaces          Workspace[]
  userRoles           UserRole[]
  assignedTasks       Task[]            @relation("AssignedTasks")
  swipesMade          Swipe[]           @relation("swiperSwipes")
  swipesReceived      Swipe[]           @relation("swipeeUserSwipes")
  messages            Message[]         @relation("MessageSender")
  projects            Project[]         @relation("ProjectCollaborators")
  userChats           UserChat[]
  chatParticipants    ChatParticipant[] @relation("ChatParticipants")
  matchUsers          MatchUser[]
  uploadedMedia       Media[]           @relation("MediaUploader")
  sentFriendships     Friendship[]      @relation("FriendshipRequester")
  receivedFriendships Friendship[]      @relation("FriendshipRecipient")

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([email])
  @@index([username])
  @@index([lastActive])
  @@index([techStackId])
  @@index([demographicId])
  @@index([createdAt])
  @@index([deletedAt]) // For soft delete queries
  @@index([firstName, lastName]) // For name searches
}

model Preferences {
  id                     String       @id @default(uuid())
  userId                 String       @unique
  user                   User         @relation(fields: [userId], references: [id])
  preferredTechStackId   String?
  preferredTechStack     TechStack?   @relation("PreferredTechStack", fields: [preferredTechStackId], references: [id])
  preferredDemographicId String?
  preferredDemographic   Demographic? @relation("PreferredDemographic", fields: [preferredDemographicId], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  matches   Match[]

  @@index([preferredTechStackId])
  @@index([preferredDemographicId])
  @@index([createdAt])
}

model Match {
  id              String         @id @default(uuid())
  userId          String         @unique
  user            User           @relation(fields: [userId], references: [id])
  matchStatus     String?
  preferencesId   String?
  preferences     Preferences?   @relation(fields: [preferencesId], references: [id])
  matchedUsers    MatchUser[]
  matchedProjects MatchProject[]
  swipes          Swipe[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([matchStatus])
  @@index([preferencesId])
  @@index([createdAt])
  @@index([deletedAt])
}

model MatchUser {
  id      String @id @default(uuid())
  matchId String
  match   Match  @relation(fields: [matchId], references: [id])
  userId  String
  user    User   @relation(fields: [userId], references: [id])

  @@unique([matchId, userId])
  @@index([matchId])
  @@index([userId])
}

model MatchProject {
  id        String  @id @default(uuid())
  matchId   String
  match     Match   @relation(fields: [matchId], references: [id])
  projectId String
  project   Project @relation(fields: [projectId], references: [id])

  @@unique([matchId, projectId])
  @@index([matchId])
  @@index([projectId])
}

model Swipe {
  id              String   @id @default(uuid())
  isRightSwipe    Boolean
  swiperId        String
  swiper          User     @relation("swiperSwipes", fields: [swiperId], references: [id])
  swipeeUserId    String?
  swipeeUser      User?    @relation("swipeeUserSwipes", fields: [swipeeUserId], references: [id])
  swipeeProjectId String?
  swipeeProject   Project? @relation(fields: [swipeeProjectId], references: [id])
  matchId         String?
  match           Match?   @relation(fields: [matchId], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([swiperId, swipeeUserId]) // Prevent duplicate user swipes
  @@unique([swiperId, swipeeProjectId]) // Prevent duplicate project swipes
  @@index([swiperId])
  @@index([swipeeUserId])
  @@index([swipeeProjectId])
  @@index([matchId])
  @@index([swiperId, createdAt]) // For user swipe history queries
  @@index([isRightSwipe, createdAt]) // For match analytics
  @@index([deletedAt]) // For soft delete queries
}

model Demographic {
  id          String        @id @default(uuid())
  country     String
  languages   String[]
  users       User[]
  preferences Preferences[] @relation("PreferredDemographic")

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([country])
  @@index([languages]) // GIN index for array queries
  @@index([createdAt])
}

model TechStack {
  id          String             @id @default(uuid())
  frameworks  String[]
  languages   String[]
  tools       String[]
  users       User[]
  preferences Preferences[]      @relation("PreferredTechStack")
  projects    ProjectTechStack[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([id])
  @@index([frameworks]) // GIN index for array queries
  @@index([languages]) // GIN index for array queries
  @@index([tools]) // GIN index for array queries
  @@index([createdAt])
}

model Project {
  id              String             @id @default(uuid())
  title           String
  description     String
  workspaceId     String
  workspace       Workspace          @relation(fields: [workspaceId], references: [id])
  chatId          String?            @unique
  chat            Chat?              @relation("ProjectChat", fields: [chatId], references: [id])
  mediaId         String?            @unique
  media           Media?             @relation("ProjectMedia", fields: [mediaId], references: [id])
  analyticsId     String?            @unique
  analytics       Analytics?         @relation("ProjectAnalytics", fields: [analyticsId], references: [id])
  techLinks       ProjectTechStack[]
  roles           Role[]
  tasks           Task[]
  collaborators   User[]             @relation("ProjectCollaborators")
  matchedProjects MatchProject[]
  swipes          Swipe[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([workspaceId])
  @@index([title]) // For project searches
  @@index([createdAt])
  @@index([updatedAt]) // For recent activity queries
  @@index([deletedAt]) // For soft delete queries
  @@index([chatId])
  @@index([mediaId])
  @@index([analyticsId])
}

model ProjectTechStack {
  id          String    @id @default(uuid())
  projectId   String
  project     Project   @relation(fields: [projectId], references: [id])
  techStackId String
  techStack   TechStack @relation(fields: [techStackId], references: [id])

  @@unique([projectId, techStackId])
  @@index([projectId])
  @@index([techStackId])
}

model Workspace {
  id          String    @id @default(uuid())
  name        String
  description String?
  userId      String    @unique
  user        User      @relation(fields: [userId], references: [id])
  projects    Project[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([name])
}

model Role {
  id          String     @id @default(uuid())
  name        String
  roleName    String
  projectId   String
  project     Project    @relation(fields: [projectId], references: [id])
  permissions String[]
  userRoles   UserRole[]
  tasks       Task[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([projectId])
}

model UserRole {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id])
  roleId     String
  role       Role      @relation(fields: [roleId], references: [id])
  assignedAt DateTime  @default(now())
  deletedAt  DateTime?

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
}

model Task {
  id           String     @id @default(uuid())
  title        String
  taskName     String
  description  String?
  userId       String?
  assignedTo   User?      @relation("AssignedTasks", fields: [userId], references: [id])
  assignedToId String? // added scalar FK if you need assignedToId available directly
  status       TaskStatus @default(PENDING)
  dueDate      DateTime?
  roleId       String
  role         Role       @relation(fields: [roleId], references: [id])
  projectId    String
  project      Project    @relation(fields: [projectId], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([projectId])
  @@index([userId])
  @@index([status])
  @@index([roleId])
  @@index([dueDate])
  @@index([projectId, status]) // Composite for project task filtering
  @@index([userId, status]) // Composite for user task filtering
  @@index([createdAt])
  @@index([updatedAt])
}

model Chat {
  id            String            @id @default(uuid())
  type          String?           @default("DIRECT") // DIRECT or PROJECT
  name          String? // Name for group/project chats
  lastMessageAt DateTime? // Add lastMessageAt field
  messages      Message[]
  userChats     UserChat[]
  participants  ChatParticipant[] // Add participants relation
  project       Project?          @relation("ProjectChat")
  projectId     String?           @unique

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([projectId])
  @@index([createdAt])
  @@index([updatedAt])
  @@index([deletedAt])
}

model ChatParticipant {
  id     String @id @default(uuid())
  userId String
  user   User   @relation("ChatParticipants", fields: [userId], references: [id])
  chatId String
  chat   Chat   @relation(fields: [chatId], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([userId, chatId])
  @@index([userId])
  @@index([chatId])
}

model UserChat {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  chatId      String
  chat        Chat      @relation(fields: [chatId], references: [id])
  unreadCount Int       @default(0) // Add unreadCount field
  lastReadAt  DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([userId, chatId])
  @@index([userId])
  @@index([chatId])
}

model Message {
  id          String  @id @default(uuid())
  content     String
  messageType String? @default("TEXT") // TEXT, IMAGE, FILE, etc.
  mediaUrl    String? // Add mediaUrl field
  senderId    String
  sender      User    @relation("MessageSender", fields: [senderId], references: [id])
  chatId      String
  chat        Chat    @relation(fields: [chatId], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([chatId])
  @@index([senderId])
  @@index([createdAt])
  @@index([chatId, createdAt]) // Composite for chat message ordering
  @@index([deletedAt]) // For soft delete queries
  @@index([messageType])
}

model Media {
  id              String          @id @default(uuid())
  filename        String
  originalName    String
  mimeType        String
  size            Int
  width           Int?
  height          Int?
  duration        Float? // For videos/audio in seconds
  url             String
  thumbnailUrl    String?
  cdnUrl          String?
  category        MediaCategory
  storageProvider StorageProvider
  storageKey      String // Path/key in storage
  bucketName      String // Storage bucket name
  uploadedBy      String
  uploader        User            @relation("MediaUploader", fields: [uploadedBy], references: [id])
  tags            String[]        @default([])
  metadata        Json? // Additional metadata

  // Relations
  project   Project? @relation("ProjectMedia")
  projectId String?  @unique

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([uploadedBy])
  @@index([category])
  @@index([storageProvider])
  @@index([createdAt])
  @@index([tags]) // GIN index for array queries
  @@index([mimeType])
  @@index([size])
  @@index([uploadedBy, category]) // Composite for user media filtering
  @@index([category, createdAt]) // Composite for category-based queries
  @@index([deletedAt]) // For soft delete queries
  @@index([filename]) // For filename searches
}

model Analytics {
  id        String   @id @default(uuid())
  stats     Json
  project   Project? @relation("ProjectAnalytics")
  projectId String?  @unique

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([projectId])
  @@index([createdAt])
  @@index([updatedAt])
}

model Friendship {
  id          String           @id @default(uuid())
  requesterId String
  requester   User             @relation("FriendshipRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  recipientId String
  recipient   User             @relation("FriendshipRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  status      FriendshipStatus @default(PENDING)
  message     String? // Optional message with friend request

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // Ensure unique friendships and prevent self-friendship
  @@unique([requesterId, recipientId])
  @@index([requesterId])
  @@index([recipientId])
  @@index([status])
  @@index([createdAt])
  @@index([requesterId, status]) // For requester's friendship filtering
  @@index([recipientId, status]) // For recipient's friendship filtering
  @@index([deletedAt]) // For soft delete queries
}

generator erd {
  provider = "prisma-erd-generator"
}
