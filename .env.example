
# Environment variables declared in this file are automatically made available to Prisma.
# See the documentation for more detail: https://pris.ly/d/prisma-schema#accessing-environment-variables-from-the-schema

# Prisma supports the native connection string format for PostgreSQL, MySQL, SQLite, SQL Server, MongoDB and CockroachDB.
# See the documentation for all the connection string options: https://pris.ly/d/connection-strings

# The following `prisma+postgres` URL is similar to the URL produced by running a local Prisma Postgres 
# server with the `prisma dev` CLI command, when not choosing any non-default ports or settings. The API key, unlike the 
# one found in a remote Prisma Postgres URL, does not contain any sensitive information.

#DATABASE_URL=YOUR_VALUE_HERE



#prisma
#OPTIMIZE_API_KEY=YOUR_VALUE_HERE

#env

# ────────────────────────────────────────────
# DATABASE (PostgreSQL via Supabase Pooling)
# ────────────────────────────────────────────


# Connect to Supabase via connection pooling
DATABASE_URL=YOUR_VALUE_HERE

# Direct connection to the database. Used for migrations
DIRECT_URL=YOUR_VALUE_HERE

# supabase is providing these for prisma - from connect I clicked connect which shows urls for connections

# ────────────────────────────────────────────
# REDIS (Docker Service)
# ────────────────────────────────────────────

# REDIS_URL=YOUR_VALUE_HERE
REDIS_URL=YOUR_VALUE_HERE


# ────────────────────────────────────────────
# KAFKA (Docker Service)
# ────────────────────────────────────────────
# KAFKA_BROKERS=YOUR_VALUE_HERE
KAFKA_BROKERS=YOUR_VALUE_HERE

# ────────────────────────────────────────────
# SUPABASE
# ────────────────────────────────────────────
SUPABASE_URL=YOUR_VALUE_HERE
SUPABASE_ANON_KEY=YOUR_VALUE_HERE
SUPABASE_SERVICE_ROLE_KEY=YOUR_VALUE_HERE
JWT_SECRET=YOUR_VALUE_HERE


# ────────────────────────────────────────────
# EMAIL (Amazon SES SMTP)
# ────────────────────────────────────────────
# Get these from AWS Console > SES > SMTP Settings
# Create SMTP credentials: https://console.aws.amazon.com/ses/home#/account
SES_SMTP_HOST=YOUR_VALUE_HERE
SES_SMTP_PORT=YOUR_VALUE_HERE
SES_SMTP_USER=YOUR_VALUE_HERE
SES_SMTP_PASSWORD=YOUR_VALUE_HERE
SES_FROM_EMAIL=YOUR_VALUE_HERE
SES_FROM_NAME=YOUR_VALUE_HERE
SES_REGION=YOUR_VALUE_HERE

# ────────────────────────────────────────────
# PUSHER (Real-time features)
# ────────────────────────────────────────────
# TODO: Add your Pusher credentials here
# Sign up at https://pusher.com/ and create a new Channels app
PUSHER_APP_ID=YOUR_VALUE_HERE
PUSHER_KEY=YOUR_VALUE_HERE
PUSHER_SECRET=YOUR_VALUE_HERE
PUSHER_CLUSTER=YOUR_VALUE_HERE

# ────────────────────────────────────────────
# APP CONFIG
# ────────────────────────────────────────────
PORT=YOUR_VALUE_HERE
NODE_ENV=YOUR_VALUE_HERE
