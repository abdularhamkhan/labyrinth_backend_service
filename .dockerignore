# =============================================================================
# 🚫 DOCKER IGNORE - OPTIMIZE BUILD PERFORMANCE & SECURITY  
# =============================================================================
#
# Excludes unnecessary files from Docker build context to:
# ✅ Reduce build time (smaller context)
# ✅ Improve security (exclude sensitive files)
# ✅ Reduce final image size
# ✅ Speed up CI/CD pipelines
#
# =============================================================================

# =============================================================================
# 📁 DIRECTORIES TO EXCLUDE
# =============================================================================

# Dependencies (will be installed in container)
node_modules/
npm-debug.log*
.npm

# Development builds (we build in container)
dist/
build/
out/

# Test coverage and reports
coverage/
.nyc_output/
test-results/

# Logs
logs/
*.log
lerna-debug.log*

# Runtime data
pids/
*.pid
*.seed
*.pid.lock

# =============================================================================
# 🔐 SENSITIVE FILES (CRITICAL SECURITY)
# =============================================================================

# Environment variables (NEVER include in image)
.env
.env.local
.env.development
.env.test
.env.production
.env.*

# Database files
*.sqlite
*.sqlite3
*.db

# Private keys and certificates
*.pem
*.key
*.crt
*.p12
*.pfx
id_rsa*
id_ed25519*

# =============================================================================
# 🛠️ DEVELOPMENT TOOLS & CONFIG
# =============================================================================

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*~

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Git
.git/
.gitignore
.gitattributes

# Docker files (avoid recursion)
Dockerfile*
docker-compose*.yml
.dockerignore

# =============================================================================
# 📝 DOCUMENTATION & ANALYSIS
# =============================================================================

# Documentation
README*.md
CHANGELOG*.md
LICENSE*
docs/
*.md

# Analysis and reports
analysis/
reports/
*.report

# =============================================================================
# 🧪 TESTING & TEMPORARY FILES
# =============================================================================

# Test files
tests/
test/
spec/
__tests__/
*.test.js
*.test.ts
*.spec.js
*.spec.ts

# Jest
jest.config.js
jest.config.ts

# Temporary files
tmp/
temp/
.tmp/
*.tmp

# =============================================================================
# ☁️ DEPLOYMENT & CI/CD
# =============================================================================

# CI/CD
.github/
.gitlab-ci.yml
.circleci/
.travis.yml
Jenkinsfile

# Deployment
deploy/
deployment/
k8s/
kubernetes/
helm/

# =============================================================================
# 📊 MONITORING & PROFILING
# =============================================================================

# Monitoring
.pm2/
ecosystem.config.js

# Profiling
*.cpuprofile
*.heapprofile
*.heapsnapshot

# =============================================================================
# 🧹 CACHE & TEMPORARY BUILD ARTIFACTS
# =============================================================================

# TypeScript
*.tsbuildinfo
.tscache/

# ESLint
.eslintcache

# Prettier
.prettierignore

# Package managers
.yarn/
.pnp.*
yarn-error.log*
.pnpm-debug.log*

# Microbundle
.rpt2_cache/
.rts2_cache_cjs/
.rts2_cache_es/
.rts2_cache_umd/

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# Yarn Integrity file
.yarn-integrity

# parcel-bundler cache (https://parceljs.org/)
.cache/
.parcel-cache/

# Next.js
.next/

# Nuxt.js
.nuxt/

# Gatsby
.cache/
public/

# Vuepress
.vuepress/dist

# Serverless
.serverless/

# FuseBox
.fusebox/

# DynamoDB Local
.dynamodb/

# =============================================================================
# 📱 MOBILE & NATIVE
# =============================================================================

# React Native
.expo/
.expo-shared/

# =============================================================================
# 🎯 CUSTOM PROJECT EXCLUSIONS
# =============================================================================

# Custom analysis files
COMPREHENSIVE_TECHNICAL_ASSESSMENT_2025.md
PROJECT_STATUS_REPORT_2025.md
IMPLEMENTATION_SUMMARY.md
DEPLOYMENT_COMMANDS.md

# Server logs
server.log*

# =============================================================================
# ✅ WHITELIST (Include these despite patterns above)
# =============================================================================

# Include these important files
!.env.example
!prisma/schema.prisma
!package*.json
